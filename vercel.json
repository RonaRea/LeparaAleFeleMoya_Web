{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "apps/admin",
      "framework": "vite"
    },
    "public": {
      "root": "apps/public",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": { "service": "admin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "public" }
    }
  ]
}
